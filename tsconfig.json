{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/lib/**/*.ts", "src/lib/**/*.tsx", "src/app/**/*.ts", "src/app/**/*.tsx", "src/styles/**/*.ts", "src/styles/**/*.css", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "prisma", "src/imports", "src/assets"]
}
